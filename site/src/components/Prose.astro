---
// Typeset for the one thing this site asks a reader to actually stay inside: a 1,500-word
// recap on a phone. Monospace at body size runs wide and tires quickly, so the measure is
// held tighter than the site default and the leading is opened up.
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    max-width: 58ch;
    font-size: 1.02rem;
    line-height: 1.85;
  }

  .prose > * {
    max-width: none;
  }

  .prose h2 {
    margin: 2.9rem 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }

  .prose h3 {
    margin: 2.4rem 0 0.6rem;
    text-transform: none;
    letter-spacing: -0.01em;
  }

  .prose h4 {
    margin: 1.8rem 0 0.5rem;
    font-size: 1rem;
    color: var(--ink-quiet);
  }

  .prose p {
    margin: 0 0 1.4em;
  }

  /* The typist's indented note, run in from the left margin with the ink rule she ruled. */
  .prose blockquote {
    margin: 1.8rem 0;
    padding: 0.9rem 0 0.9rem 1.1rem;
    border-left: 1px solid var(--violet);
    color: var(--ink-quiet);
    font-style: italic;
  }

  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .prose blockquote strong {
    color: var(--ink);
    font-style: normal;
  }

  .prose ul,
  .prose ol {
    margin: 0 0 1.4em;
    padding-left: 1.4rem;
  }

  .prose li {
    margin-bottom: 0.45em;
  }

  .prose li::marker {
    color: var(--violet);
  }

  .prose strong {
    font-weight: 700;
  }

  .prose em {
    font-style: italic;
    color: var(--ink-quiet);
  }

  .prose hr {
    margin: 2.6rem 0;
  }

  .prose a {
    text-decoration-color: var(--violet);
  }

  .prose code {
    background: var(--ground-raised);
    padding: 0.1em 0.35em;
    border: 1px solid var(--rule);
  }

  /* Any table the writer emitted still reads as a ledger, and scrolls on a phone
     rather than pushing the whole article sideways. */
  .prose table {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    margin: 1.6rem 0;
  }

  .prose th,
  .prose td {
    text-align: left;
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--rule);
  }

  .prose thead th {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-quiet);
    border-bottom: 2px solid var(--rule-strong);
  }

  .prose img {
    max-width: 100%;
    height: auto;
  }
</style>
